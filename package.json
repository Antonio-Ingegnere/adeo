{
  "name": "adeo",
  "productName": "Adeo",
  "version": "0.1.0",
  "description": "Adeo todo app",
  "main": "dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && mkdir -p dist/assets dist/server && cp index.html dist/index.html && cp styles.css dist/styles.css && cp assets/icon.png dist/assets/icon.png && cp -R server dist/server",
    "api": "python3 server/app.py",
    "prestart": "bash -lc 'PY=.venv/bin/python; if [ -x \"$PY\" ]; then $PY -c \"import fastapi\"; else python3 -c \"import fastapi\"; fi'",
    "start": "bash scripts/dev-start.sh",
    "package:mac": "bash scripts/package-mac.sh",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.adeo.app",
    "productName": "Adeo",
    "asarUnpack": [
      "dist/server/**"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "python/python-3.12.10-embed-amd64",
          "to": "python"
        }
      ]
    },
    "nsis": {
      "include": "scripts/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "extraResources": [
        { "from": "python/staged", "to": "python" },
        { "from": "vendor/mac/terminal-notifier.app", "to": "terminal-notifier.app" }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.3"
  },
  "license": "MIT",
  "dependencies": {}
}
