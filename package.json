{
  "name": "adeo",
  "productName": "Adeo",
  "version": "0.1.0",
  "description": "Adeo todo app",
  "main": "dist/main.js",
  "scripts": {
    "check:ux-boundary": "node scripts/check-ux-boundary.mjs",
    "test:workflow": "python3 .claude/scripts/delivery-selftest.py && python3 .claude/scripts/delivery-legacy-selftest.py && python3 .claude/scripts/product-designer-selftest.py",
    "quality:delivery": "python3 scripts/verify-delivery.py",
    "build": "npm run check:ux-boundary && rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node_modules/.bin/esbuild src/renderer/markdownEditor.ts --bundle --minify --format=esm --platform=browser --outfile=dist/renderer/markdownEditor.js && node_modules/.bin/esbuild src/renderer/richEditor.ts --bundle --minify --format=esm --platform=browser --outfile=dist/renderer/richEditor.js && mkdir -p dist/assets dist/server dist/styles && cp index.html dist/index.html && cp styles.css dist/styles.css && cp styles/*.css dist/styles/ && cp assets/icon.png dist/assets/icon.png && cp -R server dist/server",
    "api": "python3 server/app.py",
    "prestart": "bash -lc 'PY=.venv/bin/python; if [ -x \"$PY\" ]; then $PY -c \"import fastapi\"; else python3 -c \"import fastapi\"; fi'",
    "start": "bash scripts/dev-start.sh",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry --no-version-updates",
    "storybook:build": "npm run check:ux-boundary && storybook build --output-dir storybook-static --disable-telemetry",
    "test:isolation": "npm run build && node scripts/test-isolation-selftest.mjs",
    "test:quick-add": "npm run build && node scripts/quick-add-selftest.mjs",
    "test:task-delete": "npm run build && node scripts/task-delete-selftest.mjs",
    "test:task-row-focus": "npm run build && node scripts/task-row-focus-selftest.mjs",
    "test:edit-modal-delete": "npm run build && node scripts/edit-modal-delete-selftest.mjs",
    "test:board-move": "npm run build && node scripts/board-move-selftest.mjs",
    "test:list-pill": "npm run build && node scripts/list-pill-padding-selftest.mjs",
    "test:board": "npm run build && node scripts/board-selftest.mjs",
    "test:sidebar-state": "npm run build && node scripts/sidebar-state-selftest.mjs",
    "test:window-bounds": "npm run build && node scripts/window-bounds-selftest.mjs",
    "test:markdown-toolbar": "npm run build && node scripts/markdown-toolbar-selftest.mjs",
    "package:mac": "bash scripts/package-mac.sh",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "com.adeo.app",
    "productName": "Adeo",
    "asarUnpack": [
      "dist/server/**"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server"
      }
    ],
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "python/python-3.12.10-embed-amd64",
          "to": "python"
        }
      ]
    },
    "nsis": {
      "include": "scripts/installer.nsh"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "python/staged",
          "to": "python"
        },
        {
          "from": "vendor/mac/terminal-notifier.app",
          "to": "terminal-notifier.app"
        }
      ]
    }
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/html-vite": "10.5.10",
    "@types/node": "^22.7.4",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "playwright-core": "1.62.1",
    "storybook": "10.5.10",
    "typescript": "^5.6.3",
    "vite": "8.2.2"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "tiptap-markdown": "^0.9.0"
  }
}
